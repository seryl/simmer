{
  "schema": 1,
  "name": "app",
  "system": "x86_64-linux",
  "profile": "/nix/store/00000000000000000000000000000000-app-profile",
  "packages": [
    "/nix/store/00000000000000000000000000000000-hello-2.12.1"
  ],
  "vars": {
    "PATH": { "kind": "prefix", "value": "/nix/store/00000000000000000000000000000000-app-profile/bin" },
    "MANPATH": { "kind": "prefix", "value": "/nix/store/00000000000000000000000000000000-app-profile/share/man", "sep": ":" },
    "PRJ_ROOT": { "kind": "root" },
    "RUST_BACKTRACE": { "kind": "set", "value": "1" },
    "PYTHONPATH": { "kind": "unset" }
  },
  "commands": [
    { "name": "fmt", "help": "format the tree", "category": "code",
      "run": { "kind": "script", "source": "/nix/store/00000000000000000000000000000000-app-profile/bin/fmt" } },
    { "name": "hello", "help": "say hello",
      "run": { "kind": "exec", "program": "/nix/store/00000000000000000000000000000000-hello-2.12.1/bin/hello" } }
  ],
  "configs": [
    { "output": ".editorconfig", "source": "/nix/store/00000000000000000000000000000000-editorconfig", "mode": "link" },
    { "output": "rustfmt.toml", "source": "/nix/store/00000000000000000000000000000000-rustfmt.toml", "mode": "copy" },
    { "output": ".tool.local", "source": "/nix/store/00000000000000000000000000000000-tool.local.in", "mode": "template" }
  ],
  "providers": [
    { "env": "CPU_COUNT", "command": "getconf _NPROCESSORS_ONLN", "invalidate": "generation" }
  ],
  "motd": "app dev shell — run `hello`",
  "hooks": { "enter": null }
}
